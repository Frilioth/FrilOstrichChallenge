                            <rect controller="TabSelectorButton">
                                <simplebutton name="tabButton" depth="12" pos="0,0" width="200" height="46" font_size="24"
                                              sprite="ui_game_header_fill" bordercolor="[occBrassColor]" defaultcolor="[occHeaderBgColor]"
