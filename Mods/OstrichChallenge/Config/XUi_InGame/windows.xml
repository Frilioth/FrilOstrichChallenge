                                <label name="text" depth="10" pos="98,-5" width="924" height="560" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[occPageBodyColor]" font_size="30" text_key="occesc_him_body" foregroundlayer="true"/>
                            </rect>
                        </rect>

                        <rect name="page_out" controller="TabSelectorTab" tab_key="occesc_tab_out">
                            
                            <rect name="body" pos="0,-265" width="1100" height="600">
                                <label name="text" depth="10" pos="98,-5" width="924" height="560" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[occPageBodyColor]" font_size="30" text_key="occesc_out_body" foregroundlayer="true"/>
                            </rect>
                        </rect>

                    </rect>

                </rect>
            </rect>
        </window>
    </append>

