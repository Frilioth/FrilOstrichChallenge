    <append xpath="/windows">

        <window name="windowOccupancyRegister" depth="10" width="1200" height="910" pos="0,-42" anchor="CenterCenter" cursor_area="true"
                backgroundcolor="0,0,0,0" disableautobackground="true">

            <texture name="escFrame" depth="0" pos="-600,455" width="1200" height="910"
                     color="255,255,255,255"
                     texture="@modfolder(OstrichChallenge):Resources/ostrich_esc_frame.png"/>

            <rect name="tabs" controller="TabSelector" select_tab_contents_on_open="true">
                <rect name="core" pos="-560,445" disableautobackground="true">

                    <texture name="escSign" depth="5" pos="328,2" width="464" height="197"
                             color="255,255,255,255"
                             texture="@modfolder(OstrichChallenge):Resources/ostrich_esc_sign.png"/>

                    <rect name="tabsHeader">
