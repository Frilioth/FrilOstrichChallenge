                <label name="breach"  depth="10" pos="40,-286" width="820" height="40" justify="left" color="255,70,70" font_size="18" text="{occbreach}" foregroundlayer="true"/>

                <label name="alert"   depth="10" pos="40,-256" width="820" height="46" justify="left" color="255,230,90" font_size="21" text="{occalert}" foregroundlayer="true"/>

                <label name="rule2" depth="10" pos="40,-308" width="820" justify="left" color="40,110,40" font_size="18" text="--------------------------------------------------------------------------------------------------------" foregroundlayer="true"/>

                <label name="floorsLeft"  depth="10" pos="40,-324"  width="400" height="300" justify="left" color="120,255,120" font_size="19" text="{occfloorsleft}" foregroundlayer="true"/>
                <label name="floorsRight" depth="10" pos="460,-324" width="400" height="300" justify="left" color="120,255,120" font_size="19" text="{occfloorsright}" foregroundlayer="true"/>

                <label name="rule3" depth="10" pos="40,-600" width="820" justify="left" color="40,110,40" font_size="18" text="--------------------------------------------------------------------------------------------------------" foregroundlayer="true"/>
                <label name="state" depth="10" pos="40,-622" width="820" height="40" justify="left" color="200,220,120" font_size="20" text="{occstate}" foregroundlayer="true"/>
                <label name="close" depth="10" pos="40,-660" width="820" justify="left" color="60,160,60" font_size="18" text="PRESS ESC TO CLOSE" foregroundlayer="true"/>

            </rect>
        </window>
    </append>

