               pos="0,-3"
               width="600"
               height="38"
               text="|"
               font_size="38"
               color="[white]"
               justify="center"/>

        <sprite sprite="" color="255,255,255,255" globalopacitymod="1.8">
            <label depth="2"
                   name="TextContent"
                   pos="300,-57"
                   font_size="28"
                   color="[white]"
                   style="Outlined_Text"
                   justify="center"
                   pivot="center"
                   text="[{daycolor}]{# localization('dayname_' + ((day - 1) % 7 + 1)) }    {time}    {daytitle}: {day}[-]"
                   height="30"
                   upper_case="true"/>
        </sprite>

    </append>

    <set xpath="/windows/window[@name='HUDLeftStatBars']/rect[@name='hud'][@rows='2']/@pos">9,285</set>

