<Frils-HUD>

    <set xpath="/windows/window[@name='windowCompass']/@width">600</set>
    <set xpath="/windows/window[@name='windowCompass']/@pos">-300,-9</set>

    <remove xpath="/windows/window[@name='windowCompass']/sprite[@pos='47,0']"/>
