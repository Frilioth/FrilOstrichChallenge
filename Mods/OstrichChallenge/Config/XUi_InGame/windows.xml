                                              foregroundlayer="false" caption="{tab_name_localized}"/>
                            </rect>
                        </grid>
                    </rect>

                    <rect name="tabsContents">

                        <rect name="page_job" controller="TabSelectorTab" tab_key="occesc_tab_job">
                            
                            <rect name="body" pos="0,-265" width="1100" height="600">
                                <label name="text" depth="10" pos="98,-5" width="924" height="560" justify="left" effect="Outline8" effect_color="0,0,0,255" effect_distance="1,1" color="[occPageBodyColor]" font_size="30" text_key="occesc_job_body" foregroundlayer="true"/>
                            </rect>
                        </rect>

                        <rect name="page_him" controller="TabSelectorTab" tab_key="occesc_tab_him">
                            
