<?xml version="1.0" encoding="UTF-8"?>

<configs>

    <append xpath="/xui">
        <window_group name="serverinfowindow">
            <window name="windowOccupancyRegister"/>
        </window_group>
        <window_group name="occupancyTerminal" controller="OccupancyRegister, OstrichChallenge">
            <window name="windowOccupancyTerminal"/>
        </window_group>
        
        <window_group name="occupancyNote">
            <window name="windowOstrichNote"/>
        </window_group>
        
        <window_group name="occupancyFailed">
            <window name="windowOstrichFailed"/>
        </window_group>
        
        <window_group name="occupancyCompleted">
            <window name="windowOstrichCompleted"/>
        </window_group>
        
        <window_group name="ostrichGuide">
            <window name="windowOstrichGuide"/>
        </window_group>
    </append>

    <append xpath="/xui/window_group[@name='toolbelt']">
        <window name="windowOstrichVersion"/>
    </append>

</configs>
