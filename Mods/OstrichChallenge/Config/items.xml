            <property name="CustomIcon" value="occChocNAwe"/>
            <property name="SoundPickup" value="drug_atomjunkies_grab"/>
            <property name="SoundPlace" value="drug_atomjunkies_place"/>
            
            <property class="Action0">
                <property name="Class" value="Eat"/>
                <property name="Delay" value="1.0"/>
                <property name="Sound_start" value="player_eating"/>
                <property name="SmellUse" value="0"/>
            </property>
            
            <effect_group tiered="false" name="Food Tier 0">
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$foodAmountAdd" operation="add" value="15"/>
