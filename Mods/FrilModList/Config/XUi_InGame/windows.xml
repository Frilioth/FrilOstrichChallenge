<?xml version="1.0" encoding="UTF-8" ?>

<configs>

    <insertAfter xpath="//window[@name='ingameMenu']/grid[@name='buttons']/simplebutton[@name='btnTpPoi']">
        <simplebutton name="btnMods" depth="3" width="250" height="46" caption_key="xuiFrilMenuMods" font_size="34" />
    </insertAfter>

    <append xpath="/windows">

        <window name="windowFrilModList" anchor="center" pos="-630,400" width="1260" height="800"
                controller="FrilModList, FrilModList" cursor_area="true">

            <rect name="header" height="43" depth="1">
                <headerbg />
                <label style="header.name" pos="6,-6" width="550" text_key="xuiFrilMenuMods" />
            </rect>

            <rect name="content" pos="0,-46" height="${parentinnerheight-46}" depth="1" padding="20">
                <boxbg />

                <label name="count" depth="1" pos="0,-2" width="${parentinnerwidth-10}" height="40"
                       text="{frilmodcount}" font_size="32" color="[white]" pivot="topleft" />

                <rect name="modValues" pos="0,-55" height="${parentinnerheight-55}" depth="2"
                      on_scroll="true" gamepad_selectable="true" snap="false" use_selection_box="true">
                    <defaultscrollbar />
                    <scrollview pos="5,0" width="${parentinnerwidth-10-20}" clippingsoftness="0,10">
                        <label name="modsText1" depth="4" pos="000,0" width="390" height="400"
                               text="{frilmodcol1}" font_size="28" color="[white]"
                               pivot="topleft" overflow="resizeheight" />
                        <label name="modsText2" depth="4" pos="400,0" width="390" height="400"
                               text="{frilmodcol2}" font_size="28" color="[white]"
                               pivot="topleft" overflow="resizeheight" />
                        <label name="modsText3" depth="4" pos="800,0" width="390" height="400"
                               text="{frilmodcol3}" font_size="28" color="[white]"
                               pivot="topleft" overflow="resizeheight" />
                    </scrollview>
                </rect>
            </rect>

        </window>

    </append>

</configs>
