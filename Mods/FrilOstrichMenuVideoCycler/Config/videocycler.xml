<?xml version="1.0" encoding="UTF-8"?>
<!--
    The Ostrich Challenge - Menu Video Cycler config.

    interval  = seconds each feed plays before switching.
    <clip>    = one camera feed. uri is a mod path WITHOUT the extension
                (the engine appends .mp4 on Windows).

    Add, remove or reorder <clip> lines freely and restart. No rebuild needed.
    A listed-but-missing file is skipped and logged; the cycle carries on, so
    the lines below can sit here before the clips exist.

    ORDER IS RANDOMISED, so the order of the lines below does not matter.
    The mod shuffles the list and plays all the way through before
    reshuffling, so every feed is seen once per pass and none repeats
    back to back.

    FEWER THAN TWO CLIPS AND THE CYCLER DOES NOT RUN AT ALL, by design: there
    is nothing to cycle between, and vanilla's own menu video is left alone.

    @modfolder(X) RESOLVES AGAINST THE MODINFO NAME, NOT THE FOLDER NAME.
    ModInfo.xml says FrilOstrichMenuVideoCycler and so must the lines below.
    Change one without the other and every clip silently fails to resolve,
    with no error that points at the cause.

    The clips live in this mod's own Video/ folder, so the whole cycler is
    self-contained: one folder to install, one folder to update. The folder is
    not in the zip because it is empty until you put clips in it. Create
    FrilOstrichMenuVideoCycler/Video/ and drop them there.

    MAKING A CLIP: MP4, H.264, 1920x1080, 30fps, MUTED, and it should loop
    cleanly since a feed may be cut off mid-play when the interval expires.
    Keep each one short; 1080p clips are real files the menu loads.
-->
<videocycler interval="10">

    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam1"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam2"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam3"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam4"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam5"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam6"/>
	<clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam7"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam8"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam9"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam10"/>
    <clip uri="@modfolder(FrilOstrichMenuVideoCycler):Video/ostrich_menu_cam11"/>

</videocycler>
