	<!-- ============================================================
	     v1.2.2 fix: remove the vanilla "ItemCount=10000" override
	     on the upgrade chain.
	
	     Vanilla puts a 10000-item upgrade cost on every Full window
	     shape to stop players upgrading them before the glass breaks
	     (their Full HP is 0.001 * MaxDamage = effectively zero).
	
	     The comment in vanilla shapes.xml reads:
	       "Needed for material upgrade due to MaterialHitpointMultiplier"
	
	     With our 0.1 multiplier the Full state has real HP and the
	     anti-upgrade trap is no longer needed. Removing it makes the
	     shape inherit the block's normal upgrade cost (e.g. 8 wood or
	     10 cobblestone per material step) so windows can be upgraded
	     like any other shape.
	
	     59 shapes patched (the 2 pane shapes have no trap to remove).
	     ============================================================ -->

	<!-- Store windows (square) -->
	<remove xpath="/shapes/shape[@name='windowStoreOneSidedFull']/property[@class='UpgradeBlock']"/>
