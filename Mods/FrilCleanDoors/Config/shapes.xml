	<set xpath="/shapes/shape[@name='windowStoreOneSidedFull']/property[@name='MaterialHitpointMultiplier']/@value">0.1</set>
	<set xpath="/shapes/shape[@name='windowStoreTwoSidedFull']/property[@name='MaterialHitpointMultiplier']/@value">0.1</set>
